{
  "name": "aquilens",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "npm --prefix apps/web run lint",
    "lint:api": "npm --prefix apps/api run lint",
    "test": "npm run test:shared && npm run test:api && npm run check:product-language",
    "test:shared": "tsx --test packages/shared/src/*.test.ts",
    "test:api": "npm --prefix apps/api run test",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "check:product-language": "node scripts/check-product-language.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:supabase-auth": "node scripts/seed-supabase-auth.mjs"
  }
}
