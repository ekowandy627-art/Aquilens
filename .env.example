# Web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
ANTHROPIC_API_KEY=

# Demo seed (optional — defaults to Aquilens2024!)
DEMO_USER_PASSWORD=Aquilens2024!

# Reset GIS demo data:
#   npm run seed:demo
# Without Supabase env vars, resets in-memory demo stores (local demo auth).
# With SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, wipes GIS tenant rows and re-seeds.
