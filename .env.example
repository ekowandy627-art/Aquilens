# Root env reference — copy values into:
#   apps/web/.env.local   (web / Vercel)
#   apps/api/.env         (API / Railway)

# ─── Web (Vercel) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com/api/v1

# Local demo UI only (never enable on production Vercel)
# ALLOW_DEMO_SESSION=true

# ─── API (Railway / host) ─────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
PORT=3001

# Manager / internal API (Learn Motive-style shared secrets)
# MANAGER_PLATFORM_SECRET=

# Comma-separated browser origins (include manager + web)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://your-app.vercel.app

# Optional: SOP AI generation
ANTHROPIC_API_KEY=

# Local / staging demo bearer + reset (never enable on production API)
# ALLOW_DEMO_BEARER=true

# Demo seed password (Supabase auth users) — optional
DEMO_USER_PASSWORD=Aquilens2024!

# ─── Manager app (port 3002) ──────────────────────────────────
# PLATFORM_JWT_SECRET=          # min 32 chars; must differ from SUPABASE_JWT_SECRET
# MANAGER_PLATFORM_SECRET=      # manager → API /api/internal/* (min 16 chars)
# MANAGER_LOOKUP_SECRET=        # tenant web → manager /api/internal/tenant-lookup (same or separate)
# MANAGER_LOOKUP_URL=http://localhost:3002
# AQUILENS_API_BASE_URL=http://localhost:3001
# NEXT_PUBLIC_TENANT_APP_LOGIN_URL=http://localhost:3000/login

# ─── Tenant web (optional manager lookup) ─────────────────────
# MANAGER_LOOKUP_URL=http://localhost:3002
# MANAGER_LOOKUP_SECRET=
# TENANT_SLUG_OVERRIDE=gis

# ─── Supabase migrations (run before first production deploy) ─
# Apply all files in supabase/migrations/ in filename order, e.g.:
#   supabase db push
# or via Supabase Dashboard → SQL → run each migration.
# Latest: 202606030001_phase15_acknowledgements.sql
