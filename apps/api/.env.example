# Copy to apps/api/.env for local API dev.

# Required in production (NODE_ENV=production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

PORT=3001

# Include every web origin that calls the API (Vercel production + previews)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

ANTHROPIC_API_KEY=

# Shared with Aquilens Manager — internal control plane routes
# MANAGER_PLATFORM_SECRET=

# Local in-memory GIS demo + Playwright (never on production)
# ALLOW_DEMO_BEARER=true

# Optional DB integration tests (live Supabase project)
# SUPABASE_TEST_URL=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
