# Copy to .env.test.local (gitignored) for db-integration tests.
# SUPABASE_TEST_URL is the Supabase project URL (same as SUPABASE_URL), not a postgres:// string.
SUPABASE_TEST_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_TEST_SERVICE_ROLE_KEY=your-service-role-key
# Or reuse API keys:
# SUPABASE_TEST_URL=<same as SUPABASE_URL in .env.local>
# SUPABASE_SERVICE_ROLE_KEY=<same as in .env.local>

# Run: npm run test:db-integration
# Or: SUPABASE_TEST_URL=... SUPABASE_SERVICE_ROLE_KEY=... npm run test:db-integration
