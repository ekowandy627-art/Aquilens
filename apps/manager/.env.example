# Aquilens Manager — copy to apps/manager/.env.local

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Platform console auth (min 32 characters)
PLATFORM_JWT_SECRET=

# Shared with Aquilens API — manager calls /api/internal/*
MANAGER_PLATFORM_SECRET=

# Shared with tenant web — web calls manager /api/internal/tenant-lookup
MANAGER_LOOKUP_SECRET=

# NestJS API base (no /api/v1 suffix)
AQUILENS_API_BASE_URL=http://localhost:3001

# Shown on onboard success screen
NEXT_PUBLIC_TENANT_APP_LOGIN_URL=http://localhost:3000/login

# Bootstrap: npm run bootstrap:platform (from repo root)
# PLATFORM_BOOTSTRAP_EMAIL=platform-admin@aquilens.test
# PLATFORM_BOOTSTRAP_PASSWORD=AquilensPlatform2024!
